# === REQUIRED ===
JWT_SECRET=change-this-to-a-64-char-random-string

# === DATABASE ===
# Local dev: leave empty (uses SQLite)
# Production: Render provides this automatically
DATABASE_URL=

# === CORS ===
# Comma-separated list of allowed frontend origins
# Use * for development only
CORS_ORIGINS=*

# === OPTIONAL: IndStocks Broker Sync ===
INDSTOCKS_TOKEN=your_access_token_here
